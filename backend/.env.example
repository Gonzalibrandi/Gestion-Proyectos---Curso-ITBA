# Puerto del servidor (en Render lo define la plataforma)
PORT=3000

# URI de conexión a MongoDB (Local o MongoDB Atlas)
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/kanban-db?retryWrites=true&w=majority

# Orígenes permitidos por CORS, separados por coma (si se omite, se permite cualquier origen)
CORS_ORIGIN=http://localhost:5173

# Usuario único que crea el seed (al arrancar el servidor o con `npm run seed`)
DEMO_USER_NAME=Demo
DEMO_USER_EMAIL=demo@kanban.com
DEMO_USER_PASSWORD=demo1234
