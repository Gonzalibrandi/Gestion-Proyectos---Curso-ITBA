              "mode": "raw",
              "raw": "{\n  \"title\": \"Implementar Auth\",\n  \"description\": \"Configurar JWT en el backend\"\n}"
            },
            "url": "{{baseUrl}}/api/boards/{{boardId}}/columns/{{columnId}}/tickets"
          }
        },
        {
          "name": "05. Obtener Tablero (columnas pobladas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Tiene 2 columnas pobladas\", function () { pm.expect(json.columns).to.have.lengthOf(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/boards/{{boardId}}"
          }
        },
        {
          "name": "06. Actualizar contenido del Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
