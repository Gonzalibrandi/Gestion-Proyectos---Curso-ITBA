  "item": [
    {
      "name": "1. Flujo principal",
      "item": [
        {
          "name": "01. Crear Tablero",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"boardId\", json._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Proyecto Alpha\",\n  \"description\": \"Tablero principal del proyecto\"\n}"
            },
            "url": "{{baseUrl}}/api/boards"
          }
        },
        {
          "name": "02. Crear Columna \"To Do\"",
